{
  "name": "readmd-product-showcase",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test:config": "node --test tests/capture-config.test.mjs",
    "test:compose-lib": "node --test tests/compose-lib.test.mjs",
    "test:poster-styles": "node --test tests/poster-styles.test.mjs",
    "test:v237-update": "node --test tests/v237-update-deck.test.mjs",
    "test:v238-update": "node --test tests/v238-update-deck.test.mjs",
    "capture": "node ../ui-tests/node_modules/@playwright/test/cli.js test",
    "build:v237-update": "node update-v237/render-deck.mjs",
    "verify:v237-update": "node update-v237/render-deck.mjs --verify-only",
    "build:v238-update": "node update-v238/render-deck.mjs",
    "verify:v238-update": "node update-v238/render-deck.mjs --verify-only",
    "record": "node ../ui-tests/node_modules/@playwright/test/cli.js test --config=recording.config.js",
    "finalize-film": "node scripts/finalize-product-video.cjs",
    "product-film": "npm run record && npm run finalize-film"
  }
}
