  "hit_region_contract": {
    "live2d": {
      "source": "packages/readmd-hermes-pet-adapter/src/live2d/stage.ts L128-L129",
      "formula": "(model.hitTest(x, y).length > 0) || (model.getBounds().contains(x, y))"
    },
    "sprite": {
      "source": "third_party/hermes-agent-pet/apps/desktop/src/app/pet-overlay/pet-overlay-app.tsx L132-L165",
      "rules": [
        "if target outside petRef => return false (pass through)",
        "if !(target instanceof HTMLCanvasElement) => return true (interactive DOM chrome: bubble, mail button, composer)",
        "if target is HTMLCanvasElement => sample 2D context pixel alpha at (px, py): return alpha >= 16 (ALPHA_HIT_THRESHOLD)",
        "if canvas read throws or context is tainted => return true (fail-open so pet remains grabbable)"
      ],
      "alpha_hit_threshold": 16
    }
  },
  "toggle_app_contract": {
    "source": "src/readmd_modules/pet/hermes_adapter.py L309-L322",
    "action": "Reads system clipboard (text, PNG image, file paths) and writes { type: 'clipboard', text, image_png, paths } to FIFO. Never toggles window minimize/restore directly."
  },
  "context_menu_contract": {
    "source": "packages/readmd-hermes-pet-adapter/src/electron-main.ts L205-L224",
    "disabled_header": "Level {level} · Energy {energy} · Mood {mood}",
    "interaction_actions": [
      "pet",
      "feed",
      "play",
      "rest_or_wake"
    ],
    "rest_wake_cooldown_rule": "When resting is true, action is 'wake' and checks cooldowns['wake']. When resting is false, action is 'rest' and checks cooldowns['rest'].",
    "play_threshold_energy": 10,
    "max_characters_radio_items": 128,
    "reader_menu_action": "Open reader (writes command { type: 'open-menu' })"
  },
  "clipboard_limits": {
    "text_max_chars": 4194304,
    "image_png_base64_max_chars": 25165824,
    "paths_max_items": 128
  },
  "fifo_commands_contract": {
    "source": "packages/readmd-hermes-pet-adapter/src/bridge-transport.ts L8-L29",
    "directory_template": "${bridge}.commands",
    "envelope": "JSON.stringify({ command, created_at: Date.now() })",
    "precondition_queue_max": 128,
    "precondition_check": "existing_json_files.length >= 128 => reject with pet_command_queue_full",
    "single_file_max_bytes": 33554432,
    "total_dir_max_bytes": 67108864,
    "filename_pattern": "${Date.now().padStart(16,'0')}-${sequence.padStart(8,'0')}-${UUID}.json",
    "temp_pattern": "${target}.tmp",
    "write_mode": "exclusive_flag_wx_and_rename"
  },
  "snapshot_reader_contract": {
    "source": "packages/readmd-hermes-pet-adapter/src/bridge-transport.ts L31-L53",
    "max_bytes": 33554432,
    "golden_signature_formula": "${stat.ino}:${stat.mtimeNs}:${stat.ctimeNs}:${stat.size}",
    "windows_equivalent_signature": "${stat.volume_serial}:${stat.file_index}:${stat.last_write_time}:${stat.size}",
    "execution_flow": [
      "if this.reading return undefined",
      "stat file (bigint: true)",
      "if !stat.isFile() or stat.size > MAX_BYTES throw invalid_pet_snapshot",
      "compute signature",
      "if signature === this.signature return undefined",
      "read UTF-8 file content and JSON.parse",
      "validate: typeof value === 'object', !Array.isArray(value), value.format_version === 1",
      "on success: this.signature = signature and return value",
      "on failure: do NOT update this.signature (allows repair retry)"
    ]
  },
  "health_contract": {
    "legacy_health_file": "${bridge}.health.json",
    "legacy_owner": "Electron host main process (reportHealth function)",
    "rust_health_file": "${bridge}.rust.health.json",
    "rust_owner": "Rust host process",
    "write_protocol": "write to ${target}.tmp then atomic renameSync",
    "states": [
      "loading",
      "ready",
      "failed",
      "degraded"
    ],
    "legacy_payload_schema": {
      "state": "string (loading|ready|failed|degraded)",
      "renderer": "string (optional)",
      "code": "string (optional)",
      "pid": "number",
      "updated_at": "number"
    },
    "rust_payload_schema": {
      "engine": "rust",
      "state": "string (loading|ready|failed|degraded)",
      "renderer": "string (optional)",
      "code": "string (optional)",
      "pid": "number",
      "updated_at": "number",
      "engine_generation": "number",
      "protocol_version": "number"
    },
    "control_events_from_renderer": [
      "renderer-ready",
      "renderer-failed"
    ]
  },
  "renderer_recovery_contract": {
    "source": "packages/readmd-hermes-pet-adapter/src/electron-main.ts L165-L172",
    "trigger": "render-process-gone when details.reason !== 'clean-exit' and not shuttingDown",
    "step1_report_failed": "reportHealth('failed', lastRenderer, 'pet_renderer_crashed')",
    "step2_filter_window_ms": 60000,
    "step3_circuit_breaker_limit": 3,
    "step4_delay_formula": "500ms * recoveries.length",
    "boundary_fixtures": {
      "crash_1": "reload after 500ms",
      "crash_2": "reload after 1000ms",
      "crash_3": "reload after 1500ms",
      "crash_4_within_60s": "circuit open, no reload"
    }
  },
  "parent_liveness_contract": {
    "parent_death_shutdown": {
      "trigger": "Rust inherited stdin/pipe EOF detected",
      "action": "Immediate close overlay surface and exit process promptly. Zero arbitrary 2.5s delay.",
      "watchdog": "Optional bounded teardown watchdog (<=500ms) strictly to prevent process hangs."
    },
    "engine_replacement_grace_period": {
      "owner": "Python orchestrator",
      "action": "When swapping engine, request graceful shutdown, wait <= 2500ms, then terminate/kill exact child PID."
    }
  },
  "fallback_sprite_metadata": {
    "default_frame_w": 192,
    "default_frame_h": 208,
    "default_scale": 0.33,
    "padding_bottom_dip": 24
  },
  "bridge_poll_sequence": {
    "poll_interval_ms": 100,
    "steps": [
      "check parent host liveness; if dead close and exit promptly",
      "read snapshot via SnapshotReader",
      "if visible === false && !fullscreen close and return",
      "if surface not created: open surface",
      "else if bounds changed: clampBounds and setBounds",
      "if fullscreen === true: hide() else showInactive()",
      "if renderer changed: loadOverlayPage(renderer) and return",
      "host_publish_state()"
    ]
  }
