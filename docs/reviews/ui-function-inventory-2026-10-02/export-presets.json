      "lineHeight": 1.6,
      "spacing": 6,
      "color": "#262626",
      "align": "left"
    },
    "headings": {
      "h1": {
        "size": 20,
        "color": "#1a1a1a",
        "bold": true,
        "align": "left",
        "before": 18,
        "after": 10
      },
      "h2": {
        "size": 16,
        "color": "#1f2937",
