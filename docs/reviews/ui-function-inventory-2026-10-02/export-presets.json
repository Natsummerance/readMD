        "align": "left",
        "before": 14,
        "after": 8
      },
      "h3": {
        "size": 14,
        "color": "#2d3748",
        "bold": true,
        "align": "left",
        "before": 12,
        "after": 6
      },
      "h4": {
        "size": 12,
        "color": "#374151",
        "bold": true,
        "align": "left",
        "before": 10,
        "after": 6
      },
      "h5": {
        "size": 11,
        "color": "#4a5568",
        "bold": true,
        "align": "left",
        "before": 8,
        "after": 4
      },
      "h6": {
        "size": 10.5,
        "color": "#4a5568",
        "bold": true,
        "align": "left",
        "before": 8,
        "after": 4
      }
    },
    "table": {
      "headerBg": "#3b6ef5",
      "headerColor": "#ffffff",
      "headerBold": true,
      "borderColor": "#c8cdd4",
