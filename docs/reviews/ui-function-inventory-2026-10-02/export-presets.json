    "quote": {
      "barColor": "#3b6ef5",
      "bg": "#f3f6ff",
      "color": "#4a5568"
    },
    "link": {
      "color": "#2b6cb0"
    },
    "hr": {
      "color": "#d8dce2"
    },
    "footer": {
      "pageNumbers": true,
      "text": ""
