{
  "name": "readmd-vscode",
  "displayName": "ReadMD —— 高性能 Markdown 智能预览与自愈修复",
  "description": "轻量级本地 Markdown 智能阅读与编辑扩展：实时双向同步预览、格式自愈修复、全格式文档互转、排版级 PDF/Word/EPUB 导出、LaTeX/TikZ 科学绘图、多语言 Code Chunk、Reveal.js 演说模式、@import 模块化、[TOC]目录生成与 MCP 智能体协同。",
  "version": "2.3.7",
  "publisher": "Natsummerance",
  "icon": "icon.png",
  "license": "MIT",
  "homepage": "https://github.com/Natsummerance/readMD",
  "repository": {
    "type": "git",
    "url": "https://github.com/Natsummerance/readMD.git"
  },
  "bugs": {
    "url": "https://github.com/Natsummerance/readMD/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Formatters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "latex",
    "preview",
    "formatter",
    "bibtex",
    "readmd",
    "pdf",
    "docx",
    "presentation",
    "revealjs",
    "toc",
    "mcp"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:readmd.openAiWorkbench",
    "onCommand:readmd.openSkills",
    "onCommand:readmd.preview",
    "onCommand:readmd.fixCurrentDocument",
    "onCommand:readmd.openPresentation",
    "onCommand:readmd.exportPresentation",
    "onCommand:readmd.insertToc",
    "onCommand:readmd.insertSlide",
    "onCommand:readmd.insertCodeChunk",
    "onCommand:readmd.insertDiagram",
    "onCommand:readmd.insertDocImport",
    "onCommand:readmd.insertFrontmatter",
    "onCommand:readmd.processImports",
    "onCommand:readmd.runCodeChunk",
    "onCommand:readmd.exportDocument",
    "onCommand:readmd.convertFileToMarkdown",
    "onCommand:readmd.fetchWebToMarkdown",
    "onCommand:readmd.setupMcpServer",
    "onCommand:readmd.openSkillByUri"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/markdown.json"
      }
    ],
    "commands": [
      {
        "command": "readmd.openAiWorkbench",
        "title": "ReadMD: 打开 AI Skill 工作台 (Open AI Skill Workbench)",
        "icon": "$(sparkle)"
      },
      {
        "command": "readmd.openSkills",
        "title": "ReadMD: 浏览 Skills (Browse Skills)",
        "icon": "$(list-tree)"
      },
      {
        "command": "readmd.preview",
        "title": "ReadMD: 打开智能实时双向预览 (Open Custom Preview)",
        "icon": "$(book)"
      },
      {
        "command": "readmd.fixCurrentDocument",
        "title": "ReadMD: 智能诊断并自愈修复格式错误 (Auto-Fix Markdown Formatting)",
        "icon": "$(wrench)"
      },
      {
        "command": "readmd.insertCodeChunk",
        "title": "ReadMD: 插入交互式代码块 (Insert Interactive Code Chunk)",
        "icon": "$(play)"
      },
      {
        "command": "readmd.insertDiagram",
        "title": "ReadMD: 插入科学与工程图表 (Insert Diagram: PlantUML/TikZ/Vega)",
        "icon": "$(graph)"
      },
      {
        "command": "readmd.insertDocImport",
        "title": "ReadMD: 插入子文档引用 (Insert @import Module)",
        "icon": "$(references)"
      },
      {
        "command": "readmd.insertFrontmatter",
        "title": "ReadMD: 插入文档样式与演示元数据 (Insert Frontmatter & Style)",
        "icon": "$(gear)"
      },
      {
        "command": "readmd.openPresentation",
        "title": "ReadMD: 开启全屏 Reveal.js 演说模式 (Open Presentation Mode)",
        "icon": "$(screen-full)"
      },
      {
        "command": "readmd.exportPresentation",
        "title": "ReadMD: 导出 Reveal.js 演说 HTML (Export Presentation HTML)",
        "icon": "$(file-media)"
      },
      {
        "command": "readmd.insertToc",
        "title": "ReadMD: 插入 [TOC] 自动目录 (Insert TOC)",
        "icon": "$(list-tree)"
      },
      {
        "command": "readmd.insertSlide",
        "title": "ReadMD: 插入 <!-- slide --> 幻灯片分页符 (Insert Slide Break)",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "readmd.processImports",
        "title": "ReadMD: 展平并编译 @import 模块化引用 (Flatten @import Modules)",
        "icon": "$(references)"
      },
      {
        "command": "readmd.runCodeChunk",
        "title": "ReadMD: 安全运行光标所在 Python 代码块 (Run Code Chunk)",
        "icon": "$(play)"
      },
      {
        "command": "readmd.exportDocument",
        "title": "ReadMD: 排版级导出文档 (Export to PDF / Word / HTML / LaTeX)",
        "icon": "$(export)"
      },
      {
        "command": "readmd.convertFileToMarkdown",
        "title": "ReadMD: 转换为 Markdown (Convert to Markdown)",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "readmd.convertAnyFilePrompt",
        "title": "ReadMD: 转换本地文档为 Markdown...",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "readmd.fetchWebToMarkdown",
        "title": "ReadMD: 抓取网页 URL 为 Markdown (Fetch Web Page to Markdown)",
        "icon": "$(globe)"
      },
      {
        "command": "readmd.convertToLatex",
        "title": "ReadMD: 一键编译转为学术 LaTeX 源码 (Convert Markdown to LaTeX)",
        "icon": "$(file-code)"
      },
      {
        "command": "readmd.parseBibtex",
        "title": "ReadMD: 解析 BibTeX 参考文献 (Parse BibTeX Database)",
        "icon": "$(references)"
      },
      {
        "command": "readmd.setupMcpServer",
        "title": "ReadMD: 一键配置工作区 MCP Server (Setup ReadMD MCP Server)",
        "icon": "$(hubot)"
      },
      {
        "command": "readmd.openSkillByUri",
        "title": "ReadMD: 打开指定 Skill (Open Skill by URI)",
        "icon": "$(library)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "readmd-sidebar",
          "title": "ReadMD 工具箱",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "readmd-sidebar": [
        {
          "id": "readmdToolbox",
          "name": "ReadMD 快捷工具箱"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "readmd.preview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        },
        {
          "command": "readmd.openPresentation",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@2"
        },
        {
          "command": "readmd.fixCurrentDocument",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "readmd.fixCurrentDocument",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification@1"
        },
        {
          "command": "readmd.insertToc",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification@2"
        },
        {
          "command": "readmd.openPresentation",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification@3"
        },
        {
          "command": "readmd.runCodeChunk",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification@4"
        },
        {
          "command": "readmd.exportDocument",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "2_export@1"
        },
        {
          "command": "readmd.exportPresentation",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "2_export@2"
        },
        {
          "command": "readmd.convertToLatex",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "2_export@3"
        }
      ],
      "explorer/context": [
        {
          "command": "readmd.convertFileToMarkdown",
          "when": "resourceExtname =~ /\\.(docx|pdf|pptx|xlsx|tex|txt|html|png|jpg|webp)$/i",
          "group": "7_modification"
        },
        {
          "command": "readmd.parseBibtex",
          "when": "resourceExtname == .bib",
          "group": "7_modification"
        }
      ]
    },
    "configuration": {
      "title": "ReadMD",
      "properties": {
        "readmd.pythonPath": {
          "type": "string",
          "default": "",
          "description": "自定义 Python 可执行程序路径（留空则自动检测活动虚拟环境或系统 Python）"
        },
        "readmd.customCssPath": {
          "type": "string",
          "default": "",
          "description": "用户自定义全局 custom.css 文件的绝对路径"
        },
        "readmd.mcpServerPath": {
          "type": "string",
          "default": "",
          "description": "可选的 ReadMD Core/MCP 服务路径；留空使用工作区内置服务"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/bridge.test.js test/sidebarProvider.test.js",
    "package": "node scripts/stage-core.mjs && vsce package --no-dependencies",
    "publish:ovsx": "node publish-ovsx.js",
    "release:ovsx": "npm run package && npm run publish:ovsx",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.0"
  }
}
