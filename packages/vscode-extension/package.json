{
  "name": "readmd-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "2.3.8",
  "publisher": "Natsummerance",
  "icon": "icon.png",
  "license": "MIT",
  "homepage": "https://github.com/Natsummerance/readMD",
  "repository": {
    "type": "git",
    "url": "https://github.com/Natsummerance/readMD.git"
  },
  "bugs": {
    "url": "https://github.com/Natsummerance/readMD/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Formatters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "latex",
    "preview",
    "formatter",
    "bibtex",
    "readmd",
    "pdf",
    "docx",
    "presentation",
    "revealjs",
    "toc",
    "mcp"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:readmd.openAiWorkbench",
    "onCommand:readmd.openSkills",
    "onCommand:readmd.preview",
    "onCommand:readmd.fixCurrentDocument",
    "onCommand:readmd.openPresentation",
    "onCommand:readmd.exportPresentation",
    "onCommand:readmd.insertToc",
    "onCommand:readmd.insertSlide",
    "onCommand:readmd.insertCodeChunk",
    "onCommand:readmd.insertDiagram",
    "onCommand:readmd.insertDocImport",
    "onCommand:readmd.insertFrontmatter",
    "onCommand:readmd.processImports",
    "onCommand:readmd.runCodeChunk",
    "onCommand:readmd.exportDocument",
    "onCommand:readmd.convertFileToMarkdown",
    "onCommand:readmd.fetchWebToMarkdown",
    "onCommand:readmd.setupMcpServer",
    "onCommand:readmd.openSkillByUri"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/markdown.json"
      }
    ],
    "commands": [
      {
        "command": "readmd.openAiWorkbench",
        "title": "%command.openAiWorkbench%",
        "icon": "$(sparkle)"
      },
      {
        "command": "readmd.openSkills",
        "title": "%command.openSkills%",
        "icon": "$(list-tree)"
      },
      {
        "command": "readmd.preview",
        "title": "%command.preview%",
        "icon": "$(book)"
      },
      {
        "command": "readmd.fixCurrentDocument",
        "title": "%command.fixCurrentDocument%",
        "icon": "$(wrench)"
      },
      {
        "command": "readmd.insertCodeChunk",
        "title": "%command.insertCodeChunk%",
        "icon": "$(play)"
      },
      {
        "command": "readmd.insertDiagram",
        "title": "%command.insertDiagram%",
        "icon": "$(graph)"
      },
      {
        "command": "readmd.insertDocImport",
        "title": "%command.insertDocImport%",
        "icon": "$(references)"
      },
      {
        "command": "readmd.insertFrontmatter",
        "title": "%command.insertFrontmatter%",
        "icon": "$(gear)"
      },
      {
        "command": "readmd.openPresentation",
        "title": "%command.openPresentation%",
        "icon": "$(screen-full)"
      },
      {
        "command": "readmd.exportPresentation",
        "title": "%command.exportPresentation%",
        "icon": "$(file-media)"
      },
      {
        "command": "readmd.insertToc",
        "title": "%command.insertToc%",
        "icon": "$(list-tree)"
      },
      {
        "command": "readmd.insertSlide",
        "title": "%command.insertSlide%",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "readmd.processImports",
        "title": "%command.processImports%",
        "icon": "$(references)"
      },
      {
        "command": "readmd.runCodeChunk",
        "title": "%command.runCodeChunk%",
        "icon": "$(play)"
      },
      {
        "command": "readmd.exportDocument",
        "title": "%command.exportDocument%",
        "icon": "$(export)"
      },
      {
        "command": "readmd.convertFileToMarkdown",
        "title": "%command.convertFileToMarkdown%",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "readmd.convertAnyFilePrompt",
        "title": "%command.convertAnyFilePrompt%",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "readmd.fetchWebToMarkdown",
        "title": "%command.fetchWebToMarkdown%",
        "icon": "$(globe)"
      },
      {
        "command": "readmd.convertToLatex",
        "title": "%command.convertToLatex%",
        "icon": "$(file-code)"
      },
      {
        "command": "readmd.parseBibtex",
        "title": "%command.parseBibtex%",
        "icon": "$(references)"
      },
      {
        "command": "readmd.setupMcpServer",
        "title": "%command.setupMcpServer%",
        "icon": "$(hubot)"
      },
      {
        "command": "readmd.openSkillByUri",
        "title": "%command.openSkillByUri%",
        "icon": "$(library)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "readmd-sidebar",
          "title": "%view.containerTitle%",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "readmd-sidebar": [
        {
          "id": "readmdToolbox",
          "name": "%view.toolboxName%"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "readmd.preview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        },
        {
          "command": "readmd.openPresentation",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@2"
        },
        {
          "command": "readmd.fixCurrentDocument",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "readmd.fixCurrentDocument",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification@1"
        },
        {
          "command": "readmd.insertToc",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification@2"
        },
        {
          "command": "readmd.openPresentation",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification@3"
        },
        {
          "command": "readmd.runCodeChunk",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification@4"
        },
        {
          "command": "readmd.exportDocument",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "2_export@1"
        },
        {
          "command": "readmd.exportPresentation",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "2_export@2"
        },
        {
          "command": "readmd.convertToLatex",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "2_export@3"
        }
      ],
      "explorer/context": [
        {
          "command": "readmd.convertFileToMarkdown",
          "when": "resourceExtname =~ /\\.(docx|pdf|pptx|xlsx|tex|txt|html|png|jpg|webp)$/i",
          "group": "7_modification"
        },
        {
          "command": "readmd.parseBibtex",
          "when": "resourceExtname == .bib",
          "group": "7_modification"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "readmd.pythonPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.pythonPath%"
        },
        "readmd.customCssPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.customCssPath%"
        },
        "readmd.mcpServerPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.mcpServerPath%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/bridge.test.js test/sidebarProvider.test.js test/commands.test.js",
    "package": "node scripts/stage-core.mjs && vsce package --no-dependencies",
    "publish:ovsx": "node publish-ovsx.js",
    "release:ovsx": "npm run package && npm run publish:ovsx",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.0"
  }
}
